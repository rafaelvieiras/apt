---
import { repo, SOURCE_URL } from "../lib/site";

interface Props {
  current?: "packages";
}
const { current } = Astro.props;
---
<header class="top">
  <a class="brand" href="/">
    <svg viewBox="0 0 32 32" aria-hidden="true" focusable="false"><rect width="32" height="32" rx="8" fill="#0f766e" /><path d="M9 11l6 5-6 5M17 22h7" fill="none" stroke="#fff" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" /></svg>
    {repo.name}
  </a>
  <nav aria-label="Main">
    <ul>
      <li><a href="/packages" aria-current={current === "packages" ? "page" : undefined}>Packages</a></li>
      <li><a href="/#install">Install</a></li>
      <li class="opt"><a href="/#trust">Trust</a></li>
      <li class="opt"><a href="/#faq">FAQ</a></li>
      <li><a class="gh" href={SOURCE_URL}>Source</a></li>
    </ul>
  </nav>
</header>

<style>
  .top { display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: .25rem 1rem; padding: 1rem 0; }
  .brand { display: flex; align-items: center; gap: .6rem; font-weight: 700; color: var(--fg); text-decoration: none; letter-spacing: -.01em; }
  .brand svg { width: 1.7rem; height: 1.7rem; flex: none; }
  ul { display: flex; flex-wrap: wrap; gap: .25rem; list-style: none; margin: 0; padding: 0; align-items: center; }
  a { display: block; padding: .4rem .7rem; border-radius: 999px; color: var(--mut); text-decoration: none; font-size: .92rem; }
  .brand { padding: 0; color: var(--fg); font-size: 1rem; border-radius: 6px; }
  a:hover { color: var(--fg); background: var(--bg2); }
  a[aria-current="page"] { color: var(--fg); background: var(--acc-soft); }
  .gh { border: 1px solid var(--line); color: var(--fg); }
  @media (max-width: 34rem) { .opt { display: none; } }
</style>
